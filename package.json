{
  "name": "codeio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build:workspace-node": "docker build -t codeio/workspace-node:v1 infrastructure/docker/node-workspace",
    "build:workspace-python": "docker build -t codeio/workspace-python:v1 infrastructure/docker/python-workspace"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
