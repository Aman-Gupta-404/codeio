# ---------------------------------------------------
# Stage 1: Prune workspace
# ---------------------------------------------------

FROM node:22-bookworm AS pruner

WORKDIR /app

RUN corepack enable

COPY . .

RUN pnpm dlx turbo prune workspace --docker


# ---------------------------------------------------
# Stage 2: Install dependencies and build
# ---------------------------------------------------

FROM node:22-bookworm AS installer

WORKDIR /app

RUN corepack enable

# Copy only package manifests + lockfile
# generated by turbo prune
COPY --from=pruner /app/out/json/ .

RUN pnpm install --frozen-lockfile

# Copy the actual source code
COPY --from=pruner /app/out/full/ .

# Build worker and all of its workspace dependencies
RUN pnpm turbo run build --filter=workspace...


# ---------------------------------------------------
# Stage 3: Runtime
# ---------------------------------------------------

FROM node:22-bookworm AS runner

WORKDIR /app

RUN apt-get update && \
    apt-get install -y \
        python3 \
        python3-pip \
        git \
        curl \
        bash \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY --from=installer /app .

RUN mkdir -p /workspace

EXPOSE 8080

CMD ["pnpm", "--filter", "workspace", "start"]