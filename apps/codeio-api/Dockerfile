# ---------------------------------------------------
# Stage 1: Prune workspace
# ---------------------------------------------------

FROM node:22-alpine AS pruner

WORKDIR /app

RUN corepack enable

COPY . .

RUN pnpm dlx turbo prune codeio-api --docker


# ---------------------------------------------------
# Stage 2: Install dependencies and build
# ---------------------------------------------------

FROM node:22-alpine AS installer

WORKDIR /app

RUN corepack enable

# Copy only package manifests and lockfile
# generated by turbo prune
COPY --from=pruner /app/out/json/ .

RUN pnpm install --frozen-lockfile

# Copy the actual source code
COPY --from=pruner /app/out/full/ .

# Build API and its workspace dependencies
RUN pnpm turbo run build --filter=codeio-api...


# ---------------------------------------------------
# Stage 3: Runtime
# ---------------------------------------------------

FROM node:22-alpine AS runner

WORKDIR /app

RUN corepack enable

COPY --from=installer /app .

EXPOSE 3001

CMD ["pnpm", "--filter", "codeio-api", "start"]